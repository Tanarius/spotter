# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_ID=your-numeric-telegram-user-id
# Local dev bot (optional, LOCAL ONLY — never set on Railway). When set, this
# token is used instead of TELEGRAM_BOT_TOKEN so a local run polls a separate
# BotFather bot and never collides with the deployed poller (409 on getUpdates).
# TELEGRAM_DEV_ALLOWED_USER_ID optionally overrides the allowlist with it.
TELEGRAM_DEV_BOT_TOKEN=
# TELEGRAM_DEV_ALLOWED_USER_ID=

# Model providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key            # optional: enables Telegram voice input (Whisper)

# Defaults
DEFAULT_MODEL=claude-sonnet-4-6
# Local: a path relative to the repo root (resolved under it).
# Railway: an ABSOLUTE path on the mounted Volume so the SQLite DB survives
# redeploys — attach a Volume mounted at /data and set DB_PATH=/data/spotter.db
DB_PATH=data/spotter.db
# Weekly DB backups (Sunday 03:00 TIMEZONE, plus boot catch-up when stale)
# land in <db_dir>/backups/; keep this many.
BACKUP_RETAIN=4
# Conditions engine: daily check time (HH:MM in TIMEZONE); at most one nudge/day.
NUDGE_TIME=13:00
BRIEF_TIME=08:00
# Daily evening check-in, HH:MM in TIMEZONE
EVENING_TIME=18:00
TIMEZONE=America/Chicago

# Seed context.
# Local dev uses seed/context.yaml (gitignored) and leaves this blank.
# On Railway (where the file doesn't exist), paste the FULL contents of your
# seed/context.yaml here as a single multi-line variable value.
SEED_CONTEXT_YAML=

# GitHub webhook ingestion (memory layer). Set the SAME random secret here and
# in the GitHub webhook config (repo -> Settings -> Webhooks). Unset means the
# /webhooks/github endpoint is not served at all.
GITHUB_WEBHOOK_SECRET=

# Claude Code session notes (memory layer). Shared secret for the
# /webhooks/session endpoint; Claude Code sends it as X-Spotter-Secret at
# session end. Unset means the endpoint is not served at all.
SESSION_NOTE_SECRET=

# Semantic retrieval (memory layer). Voyage AI key for embeddings
# (dash.voyageai.com; generous free tier). Unset = retrieval falls back to
# keyword scoring — nothing breaks.
VOYAGE_API_KEY=
# EMBED_MODEL=voyage-3.5-lite

# Web dashboard.
# The dashboard only serves when DASHBOARD_PASSWORD is set — unset means the
# web server never starts (it refuses to run open). Pick a long random value.
DASHBOARD_PASSWORD=
# Port the dashboard binds. Railway injects PORT automatically; locally the
# default is 8080, so you normally leave this unset.
# PORT=8080
