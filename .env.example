# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_ALLOWED_USER_ID=your-numeric-telegram-user-id

# Model providers
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key            # optional (unused until Step 6)

# Defaults
DEFAULT_MODEL=claude-sonnet-4-6
# Local: a path relative to the repo root (resolved under it).
# Railway: an ABSOLUTE path on the mounted Volume so the SQLite DB survives
# redeploys — attach a Volume mounted at /data and set DB_PATH=/data/spotter.db
DB_PATH=data/spotter.db
BRIEF_TIME=08:00
# Daily evening check-in, HH:MM in TIMEZONE
EVENING_TIME=18:00
TIMEZONE=America/Chicago

# Seed context.
# Local dev uses seed/context.yaml (gitignored) and leaves this blank.
# On Railway (where the file doesn't exist), paste the FULL contents of your
# seed/context.yaml here as a single multi-line variable value.
SEED_CONTEXT_YAML=

# Web dashboard.
# The dashboard only serves when DASHBOARD_PASSWORD is set — unset means the
# web server never starts (it refuses to run open). Pick a long random value.
DASHBOARD_PASSWORD=
# Port the dashboard binds. Railway injects PORT automatically; locally the
# default is 8080, so you normally leave this unset.
# PORT=8080
